ENV=development
SECRET_KEY=replace-with-a-random-string-at-least-32-characters
JWT_ISS=skullmod
JWT_AUD=skullmod-app
JWT_EXPIRE_DAYS=30
DATABASE_URL=sqlite:///./skullmod.db
DEFAULT_TZ=Europe/Istanbul

# Development can use "*".
# Production should use explicit app/web origins, comma-separated.
CORS_ORIGINS=*
PUBLIC_NFC_BASE_URL=https://skullmod.app
